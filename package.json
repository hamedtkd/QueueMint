{
  "name": "queuemint",
  "private": true,
  "version": "1.0.0-rc.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:architecture && tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "font:install": "node ./scripts/install-samim.mjs",
    "check:architecture": "node ./scripts/check-file-size.mjs",
    "check": "npm run check:architecture && npm run typecheck",
    "verify": "npm run check:architecture && npm run typecheck && npm run build && npm run check:release",
    "check:release": "node ./scripts/check-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animated": "2.1.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.2.8",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
