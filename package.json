{
  "name": "queuemint",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:architecture && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test",
    "preview": "vite preview",
    "check:architecture": "node ./scripts/check-file-size.mjs",
    "check": "npm run check:architecture && npm run typecheck && npm test",
    "verify": "npm run check:architecture && npm run typecheck && npm test && npm run build && npm run check:release",
    "check:release": "node ./scripts/check-release.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animated": "2.1.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.3.7",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
